###############################################################################
# REQUIRED ENV VARS (core app)
#
# Start here:
# 1) Copy this file to `.env`
# 2) Fill in the REQUIRED values
#
# Docs:
# - `Documentations/ENVIRONMENT_VARIABLES.md`
# - `Documentations/GETTING_STARTED.md`
###############################################################################

## Site (server + build scripts)
# Used by `server.js`, RSS, and sitemap scripts.
SITE_URL=http://localhost:5173

## Site (frontend)
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=ZCraft Network
VITE_SITE_SHORT_NAME=ZCraft

## Supabase (frontend)
# Required for the app to load.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

###############################################################################
# OPTIONAL ENV VARS (features + integrations)
###############################################################################

## API base (optional)
# Only needed if your Express API (`server.js`) runs on a different origin.
VITE_SERVER_API_URL=

## Supabase (server + tooling) (recommended)
# Recommended for:
# - `npm run build` (RSS + sitemap scripts)
# - `node server.js` API routes
# - any server-side writes that need service-role permissions
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

## Supabase (auth/session storage keys; optional)
VITE_SUPABASE_AUTH_STORAGE_KEY=zcraft-auth
VITE_SUPABASE_STORAGE_KEY=zcraft-oauth-provider-token
VITE_SUPABASE_REFRESH_KEY=zcraft-oauth-provider-refresh-token

## Discord OAuth (optional, enables "Connect Discord" + chat identity)
# Docs: `CHAT_BRIDGE_SETUP.md`
VITE_DISCORD_OAUTH_SCOPES=identify email guilds.join
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

## Discord Chat Bridge (optional)
# Used by Edge Functions and API routes.
DISCORD_BOT_TOKEN=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_CHAT_INGEST_SECRET=
# Used by `/api/discord/join-server` auto-join endpoint.
DISCORD_GUILD_ID=

## Appeals -> Discord webhook (optional)
APPEAL_DISCORD_WEBHOOK_URL=

## Navigation URLs (optional)
VITE_DISCORD_URL=
VITE_PLAY_IP=
VITE_BEDROCK_IP=
VITE_SUPPORT_URL=/support
VITE_APPEAL_URL=/appeal
VITE_STORE_URL=
VITE_STATUS_URL=
VITE_WIKI_URL=
VITE_BANS_URL=
VITE_FORUMS_URL=/forums
VITE_NEWS_URL=/news
VITE_CHANGELOGS_URL=/events
VITE_SERVER_LISTINGS_URL=/server-listings
VITE_RULES_URL=/rules
VITE_STAFF_URL=/staff
VITE_EVENTS_URL=/events

## Feature flags (optional)
VITE_FEATURE_MAINTENANCE_BANNER=true
VITE_FEATURE_ANNOUNCEMENT_BANNER=true
VITE_FEATURE_HOME_HERO=true
VITE_FEATURE_HERO_STATS=true
VITE_FEATURE_HOME_FEATURES=true
VITE_FEATURE_HOME_COMMUNITY=true
VITE_FEATURE_PLAY=true
VITE_FEATURE_FORUMS=true
VITE_FEATURE_NEWS=true
VITE_FEATURE_CHANGELOGS=true
VITE_FEATURE_EVENTS=true
VITE_FEATURE_STATUS=true
VITE_FEATURE_STORE=true
VITE_FEATURE_SUPPORT=true
VITE_FEATURE_STAFF=true
VITE_FEATURE_SERVER_LISTINGS=true
VITE_FEATURE_RULES=true
VITE_FEATURE_WIKI=true
VITE_FEATURE_APPEAL=true
VITE_FEATURE_BANS=true
VITE_FEATURE_DISCORD_BUTTON=true
VITE_FEATURE_COPY_IP_BUTTON=true
VITE_FEATURE_THEME_TOGGLE=true
VITE_FEATURE_COOKIE_BANNER=true

## Site / branding (optional overrides)
VITE_SITE_DOMAIN=
VITE_SITE_LOGO=/zcraft-logo.png
VITE_SITE_ICON=/favicon.ico
VITE_SITE_APPLE_TOUCH_ICON=/apple-touch-icon.png
VITE_SITE_OG_IMAGE=/zcraft.png
VITE_SEO_IMAGE_URL=
VITE_SITE_ICON_URL=
VITE_SITE_APPLE_TOUCH_ICON_URL=
VITE_THEME_COLOR=#3b82f6
VITE_TWITTER_HANDLE=

## SEO (optional overrides)
VITE_SEO_TITLE=
VITE_SEO_DESCRIPTION=
VITE_SEO_KEYWORDS=
VITE_SEO_IMAGE=/zcraft.png
VITE_SEO_TYPE=website
VITE_SEO_AUTHOR=
VITE_PAGE_HOME_TITLE=
VITE_PAGE_HOME_DESCRIPTION=
VITE_PAGE_HOME_KEYWORDS=
VITE_PAGE_SUPPORT_TITLE=
VITE_PAGE_SUPPORT_DESCRIPTION=
VITE_PAGE_SUPPORT_KEYWORDS=
VITE_PAGE_APPEAL_TITLE=
VITE_PAGE_APPEAL_DESCRIPTION=
VITE_PAGE_APPEAL_KEYWORDS=
VITE_GOOGLE_SITE_VERIFICATION=

## Analytics (optional)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

## Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

## Email (SendPulse) (optional)
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_FROM_EMAIL=
SENDPULSE_FROM_NAME=ZCraft Network
EMAIL_UNSUBSCRIBE_SECRET=

## Build scripts (optional)
SITEMAP_FORUM_LIMIT=500
RSS_AUTH_TOKEN=

## CORS (optional, server.js)
CORS_ALLOW_ORIGIN=*

## Server (optional, server.js)
PORT=3000

## Branding strings (optional overrides)
VITE_SITE_LEGAL_NOTICE=© 2024-2026 ZCraft Network. All rights reserved.
VITE_LICENSE_EMAIL=license@yourdomain.com
VITE_COMPANY_NAME=ZCraft Network
VITE_COMPANY_SHORT_NAME=ZCraft
VITE_NEWS_FEED_TITLE=ZCraft News Feed
VITE_NEWS_FEED_DESCRIPTION=Latest news from ZCraft Network
VITE_EMAIL_SUBJECT_LOGIN_ALERT=New login to your ZCraft account
VITE_EMAIL_SUBJECT_ANNOUNCEMENT=Important Announcement from ZCraft Network
VITE_EMAIL_WELCOME_MESSAGE=Welcome to ZCraft Network

## Misc (optional)
VITE_ENABLE_PASSKEYS=false

###############################################################################
# LUKITTU LICENSE SYSTEM (recommended for sold builds)
#
# This project can enforce a Lukittu license at runtime (server + API).
# Docs: https://docs.lukittu.com/api-reference/introduction
###############################################################################

# Your Lukittu license key (provided to the buyer).
# Placeholder (replace on install):
Licesnse_Key=%%__LUKITTU_LICENSE_KEY__%%

# Optional: identifiers sent with verification/heartbeat.
LUKITTU_BRANCH=production
LUKITTU_VERSION=1.0.0


# Enable/disable enforcement (defaults: true in production, false otherwise).
LUKITTU_ENFORCE=true
