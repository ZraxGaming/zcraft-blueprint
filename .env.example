# SITEMAP / Supabase settings
SITE_URL=https://z-craft.xyz
VITE_SERVER_API_URL=https://api.yourdomain.com
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase Service Role Key if you want the generator to read protected data. Otherwise, a public anon key may work for public tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: limit number of forum threads included in sitemap
SITEMAP_FORUM_LIMIT=500

SENDPULSE_CLIENT_ID=your-sendpulse-client-id
SENDPULSE_CLIENT_SECRET=your-sendpulse-client-secret
SENDPULSE_FROM_EMAIL=hello@yourdomain.com
SENDPULSE_FROM_NAME=ZCraft Network
EMAIL_UNSUBSCRIBE_SECRET=your-long-random-secret

VITE_SUPABASE_AUTH_STORAGE_KEY=zcraft-auth
VITE_ENABLE_PASSKEYS=false
