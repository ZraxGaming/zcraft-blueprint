# SITEMAP / Supabase settings
SITE_URL=https://z-craft.xyz
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase Service Role Key if you want the generator to read protected data. Otherwise, a public anon key may work for public tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: limit number of forum threads included in sitemap
SITEMAP_FORUM_LIMIT=500

# OneSignal web push / email / custom events
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
ONESIGNAL_EMAIL_FROM_ADDRESS=hello@yourdomain.com
ONESIGNAL_EMAIL_REPLY_TO_ADDRESS=support@yourdomain.com
ONESIGNAL_EMAIL_SENDER_DOMAIN=yourdomain.com
VITE_ONESIGNAL_ALLOWED_HOSTS=www.z-craft.xyz
VITE_SUPABASE_AUTH_STORAGE_KEY=zcraft-auth
VITE_ENABLE_PASSKEYS=false
